# What GitHub's download zip leaves out: only addons/kodogu/, the README and the licence are
# installed into a project. (The Godot Asset Store zip is narrower still: addons/kodogu/ alone;
# see "Licence and releases" in the README.)
/.gitattributes export-ignore
/.gitignore export-ignore
/project.godot export-ignore
/test export-ignore
/media export-ignore
/STORE.md export-ignore
